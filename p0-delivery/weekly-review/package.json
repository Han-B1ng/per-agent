{
  "name": "pe-weekly-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人成长指数 · 本周复盘（Vue 3 + TypeScript 独立功能模块）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5184 --strictPort",
    "test": "vitest run",
    "test:e2e": "node tests/preview.mjs",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
