# P0 服务端（server/index.mjs）环境变量。前端零依赖、无需 env。
# 复制为 .env 后用 `node --env-file=.env server/index.mjs` 启动。
# .env 已被 .gitignore 排除，切勿把真实密钥提交进仓库。
# 不填 MODEL_API_KEY 时自动走本地 Mock（顶栏标「本地 Mock」）。

# 模型代理使用的 API Key（只放服务端；公开部署放 Sites Secret）
MODEL_API_KEY=

# OpenAI 兼容端点（默认 https://api.openai.com/v1）
MODEL_BASE_URL=

# 模型名（默认 gpt-4o-mini）
MODEL_NAME=

# 单次调用超时毫秒（默认 20000）
MODEL_TIMEOUT_MS=

# 是否发送 response_format=json_object（1 默认 / 0 关闭，兼容不支持的端点）
MODEL_JSON_MODE=

# 监听地址/端口（默认 127.0.0.1:8123）
HOST=
PORT=